# Configuração Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-service-role-key-aqui

# Configuração Google Sheets
# Opção 1: Caminho para o arquivo credentials.json baixado da Google Cloud Console
GOOGLE_CREDENTIALS_PATH=google_credentials.json

# Opção 2 (Opcional, ideal para EasyPanel sem volume montado): Cole o JSON inteiro da conta de serviço
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Arquivo de configuração de campanhas
CONFIG_FILE=config.json

# Intervalo entre execuções (em minutos)
SYNC_INTERVAL_MINUTES=10

